; ── 날씨 (공공데이터포털 동네예보 프록시) ─────────────────────
(define KMA_KEY "41NpNiA9jReg6/CzWVDJxJ1r+9+IBybpCkxBBU5uxTTAIpycbOwQAI1YNrW0SWNXb6fEEcGZtXyZtTws8EK7jQ==")

(defn handle-weather [$req]
  (let [[$nx (or (server_req_query $req "nx") "60")]
        [$ny (or (server_req_query $req "ny") "127")]
        [$base_date (or (server_req_query $req "base_date") "")]
        [$base_time (or (server_req_query $req "base_time") "")]
        [$url (str "http://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getUltraSrtNcst?serviceKey=41NpNiA9jReg6%2FCzWVDJxJ1r%2B9%2BIBybpCkxBBU5uxTTAIpycbOwQAI1YNrW0SWNXb6fEEcGZtXyZtTws8EK7jQ%3D%3D&pageNo=1&numOfRows=20&dataType=JSON&base_date=" $base_date
                   "&base_time=" $base_time "&nx=" $nx "&ny=" $ny)]
        [$res (http_get $url)]
        [$body (get $res "body")]]
    (assoc (server_status 200 $body) "contentType" "application/json; charset=utf-8")))


; ── 일별 날씨 로그 ─────────────────────────────────────────────
(defn handle-list-weather-log [$req]
  (let [[$uid (get-uid $req)]]
    (if (nil? $uid) (res-401)
      (let [[$all (dedupe (db-get "move_weather_log") "id")]
            [$mine (mine-only $all $uid)]]
        (res-ok $mine)))))

(defn handle-post-weather-log [$req]
  (let [[$uid (get-uid $req)]]
    (if (nil? $uid) (res-401)
      (let [[$body (json_parse (server_req_body $req))]
            [$date (or (get $body "date") "")]
            [$entry (assoc (assoc (assoc (assoc {}
                "id"      (str "wxl-" $uid "-" $date))
                "userId"  $uid)
                "date"    $date)
                "weather" (or (get $body "weather") ""))]]
        (db-post "move_weather_log" $entry)
        (res-ok $entry)))))


; ── 친구 시스템 ────────────────────────────────────────────────
(defn handle-list-friends [$req]
  (let [[$uid (get-uid $req)]]
    (if (nil? $uid) (res-401)
      (let [[$all (dedupe (db-get "move_friends") "id")]
            [$mine (mine-only (active-only $all) $uid)]]
        (res-ok $mine)))))

(defn handle-post-friend [$req]
  (let [[$uid (get-uid $req)]]
    (if (nil? $uid) (res-401)
      (let [[$body (json_parse (server_req_body $req))]
            [$friendUid (or (get $body "friendUid") "")]
            [$friendName (or (get $body "friendName") "친구")]
            [$entry (assoc (assoc (assoc (assoc {}
                "id"         (str "mfr-" (now_ms)))
                "userId"     $uid)
                "friendUid"  $friendUid)
                "friendName" $friendName)]]
        (db-post "move_friends" $entry)
        (res-ok $entry)))))

(defn handle-delete-friend [$req]
  (let [[$uid (get-uid $req)]]
    (if (nil? $uid) (res-401)
      (let [[$id (server_req_param $req "id")]
            [$all (dedupe (db-get "move_friends") "id")]
            [$entry (first (filter (fn [$e] (= (get $e "id") $id)) $all))]]
        (if (nil? $entry) (res-404 "없음")
          (let [[$soft (assoc $entry "deletedAt" (now_iso))]]
            (db-post "move_friends" $soft)
            (res-ok {:deleted true})))))))

; 친구의 sessions 요약 조회 (집계만, 경로 제외)
(defn handle-friend-sessions [$req]
  (let [[$uid (get-uid $req)]]
    (if (nil? $uid) (res-401)
      (let [[$friendUid (or (server_req_query $req "uid") "")]
            [$all (dedupe (db-get "move_sessions") "id")]
            [$active (active-only $all)]
            [$friendSessions (filter (fn [$s] (= (get $s "userId") $friendUid)) $active)]
            [$summary (map (fn [$s] (assoc (assoc (assoc (assoc (assoc (assoc {}
                "startedAt" (get $s "startedAt"))
                "sport"     (get $s "sport"))
                "distance"  (get $s "distance"))
                "duration"  (get $s "duration"))
                "calories"  (get $s "calories"))
                "weather"   (get $s "weather"))) $friendSessions)]]
        (res-ok $summary)))))

(defn handle-index [$req]
  (assoc (server_html (file_read "public/index.html")) "headers" {"Cache-Control" "no-store, must-revalidate"}))

(server_get  "/"                       "handle-index")
(server_get  "/login"                  "handle-login-page")
(server_post "/api/auth/login"         "handle-auth-login")
(server_get  "/health"                 "handle-health")
(server_get  "/api/auth/me"            "handle-auth-me")
(server_post "/api/auth/logout"        "handle-auth-logout")

(server_get    "/api/sessions"         "handle-list-sessions")
(server_post   "/api/sessions"         "handle-post-session")
(server_delete "/api/sessions/:id"     "handle-delete-session")


(defn handle-sw [$req]
  (let [[$content (file_read "public/sw.js")]]
    (assoc (server_status 200 $content) "contentType" "application/javascript; charset=utf-8")))

(defn handle-manifest [$req]
  (let [[$content (file_read "public/manifest.json")]]
    (assoc (server_status 200 $content) "contentType" "application/manifest+json; charset=utf-8")))

(defn handle-icon [$req]
  (let [[$name (server_req_param $req "name")]
        [$path (str "public/icons/" $name)]
        [$content (file_read $path)]]
    (if (nil? $content) (res-404 "icon not found")
      (assoc (server_status 200 $content) "contentType" "image/svg+xml"))))


(server_get    "/api/schedules"        "handle-list-schedules")
(server_post   "/api/schedules"        "handle-post-schedule")
(server_delete "/api/schedules/:id"    "handle-delete-schedule")
(server_get    "/api/goals"            "handle-list-goals")
(server_post   "/api/goals"            "handle-post-goal")
(server_delete "/api/goals/:id"        "handle-delete-goal")
(server_get    "/api/budgets"          "handle-list-budgets")
(server_post   "/api/budgets"          "handle-post-budget")
(server_delete "/api/budgets/:id"      "handle-delete-budget")

(server_get    "/api/friends"          "handle-list-friends")
(server_post   "/api/friends"          "handle-post-friend")
(server_delete "/api/friends/:id"      "handle-delete-friend")
(server_get    "/api/friend-sessions"  "handle-friend-sessions")
(server_get  "/api/weather-log"  "handle-list-weather-log")
(server_post "/api/weather-log"  "handle-post-weather-log")
(server_get "/api/weather" "handle-weather")
(server_get "/sw.js" "handle-sw")
(server_get "/manifest.json" "handle-manifest")
(server_get "/icons/:name" "handle-icon")

(server_start PORT)
(println (str "🏃 AKL Move listening on " PORT))
