; ═══════════════════════════════════════════════════════════════
; AKL MOVE — 걷기/달리기/자전거 통합 GPS 트래커
; FreeLang v11 | Port: 39060 | DB: MariaDB akl.move_sessions
; ═══════════════════════════════════════════════════════════════

(define PORT 39060)
(define USERINFO_URL "http://localhost:39000/api/auth/userinfo")

(load "/home/kimjin/services/akl-lib/mariadb.fl")
(load "/home/kimjin/services/akl-lib/auth.fl")
(load "/home/kimjin/services/akl-lib/response.fl")

(defn active-only [$items] (filter (fn [$it] (nil? (get $it "deletedAt"))) $items))
(defn mine-only [$items $uid] (filter (fn [$it] (= (get $it "userId") $uid)) $items))

(defn handle-auth-me [$req]
  (let [[$auth   (server_req_header $req "authorization")]
        [$cookie (server_req_cookie $req "akl_token")]
        [$bearer (if (and $auth (> (length $auth) 7))
                   (substring $auth 7 (length $auth)) nil)]
        [$token  (or $bearer $cookie)]]
    (if (nil? $token) (res-401)
      (let [[$res  (http_get_bearer USERINFO_URL $token)]
            [$body (json_parse (get $res "body"))]]
        (server_json $body)))))

(defn handle-login-page [$req]
  (assoc (server_html (file_read "public/login.html")) "headers" {"Cache-Control" "no-store"}))

(defn handle-auth-login [$req]
  (let [[$body  (server_req_body $req)]
        [$res   (http_post "http://localhost:39000/api/auth/login" $body)]
        [$status (or (get $res "status") 200)]
        [$out   (json_parse (get $res "body"))]]
    (server_status $status $out)))

(defn handle-auth-logout [$req]
  (let [[$auth (server_req_header $req "authorization")]]
    (if (and $auth (> (length $auth) 7))
      (http_request "POST" "http://localhost:39000/api/auth/logout"
        {"Authorization" $auth "Content-Type" "application/json"}
        "{}")
      nil))
  (server_json {:success true :data {:loggedOut true}}))

(defn handle-health [$req]
  (res-ok {:status "ok" :service "akl-move" :version "1.0.0"}))

; ── 세션 ────────────────────────────────────────────────────────
(defn handle-list-sessions [$req]
  (let [[$uid (get-uid $req)]]
    (if (nil? $uid) (res-401)
      (let [[$all  (dedupe (db-get "move_sessions") "id")]
            [$mine (mine-only (active-only $all) $uid)]]
        (res-ok $mine)))))

(defn handle-post-session [$req]
  (let [[$uid (get-uid $req)]]
    (if (nil? $uid) (res-401)
      (let [[$body (json_parse (server_req_body $req))]
            [$entry (assoc (assoc (assoc (assoc (assoc (assoc (assoc (assoc (assoc (assoc (assoc (assoc {}
                "id"        (str "ms-" (now_ms)))
                "userId"    $uid)
                "sport"     (or (get $body "sport") "walk"))
                "startedAt" (or (get $body "startedAt") (now_iso)))
                "endedAt"   (or (get $body "endedAt") (now_iso)))
                "duration"  (or (get $body "duration") 0))
                "distance"  (or (get $body "distance") 0))
                "avgSpeed"  (or (get $body "avgSpeed") 0))
                "calories"  (or (get $body "calories") 0))
                "path"      (or (get $body "path") []))
                "notes"     (or (get $body "notes") ""))
                "weather"   (or (get $body "weather") ""))]]
        (db-post "move_sessions" $entry)
        (res-ok $entry)))))

(defn handle-delete-session [$req]
  (let [[$uid (get-uid $req)]]
    (if (nil? $uid) (res-401)
      (let [[$id (server_req_param $req "id")]
            [$all (dedupe (db-get "move_sessions") "id")]
            [$entry (first (filter (fn [$e] (= (get $e "id") $id)) $all))]]
        (if (nil? $entry) (res-404 "세션 없음")
          (if (not (= (get $entry "userId") $uid)) (res-401)
            (let [[$soft (assoc $entry "deletedAt" (now_iso))]]
              (db-post "move_sessions" $soft)
              (res-ok {:deleted true}))))))))


